PORT=3000
NODE_ENV=development
CORS_ORIGIN=*
JWT_SECRET=super-secret-jwt-key-change-in-production

# Microservice URLs 
USER_SERVICE_URL=http://localhost:3001
SUBSCRIPTION_SERVICE_URL=http://localhost:3002
REPORTING_SERVICE_URL=http://localhost:3003
STATIC_ANALYSIS_SERVICE_URL=http://localhost:8001
RAG_LLM_SERVICE_URL=http://localhost:8002
